{
  "cli": {
    "version": ">= 3.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "android": {
        "gradleCommand": ":app:assembleRelease"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "API_BASE_URL": "https://api-dev.samaanai.com"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "API_BASE_URL": "https://samaanai-backend-staging-362270100637.us-west1.run.app"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "staging": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "API_BASE_URL": "https://samaanai-backend-staging-362270100637.us-west1.run.app"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "API_BASE_URL": "https://samaanai-backend-172298808029.us-west1.run.app"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "your-apple-id@example.com",
        "ascAppId": "1234567890",
        "appleTeamId": "TEAMID123"
      },
      "android": {
        "serviceAccountKeyPath": "./secrets/google-play-key.json",
        "track": "internal"
      }
    }
  }
}